<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ArkhamCompanion" parent="Theme.AppCompat.Light.NoActionBar" />

    <style name="Theme.ArkhamCompanion.Splash" parent="Theme.SplashScreen">
        <!-- Set the splash screen background color -->
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <!-- Set the splash screen icon drawable -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic__splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ArkhamCompanion</item>
    </style>
</resources>